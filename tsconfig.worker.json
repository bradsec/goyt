{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": "frontend/src",
    "outDir": "internal/ui/assets",
    "sourceMap": false,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["frontend/src/sw.ts"]
}
